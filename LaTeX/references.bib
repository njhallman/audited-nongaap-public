
@article{GHW2023,
	title = {Securities and {Exchange} {Commission} {Regulation} and {Non}-{GAAP} {Income} {Statements}},
	volume = {98},
	issn = {1558-7967, 0001-4826},
	url = {https://publications.aaahq.org/accounting-review/article/98/2/149/390/Securities-and-Exchange-Commission-Regulation-and},
	doi = {10.2308/TAR-2018-0719},
	abstract = {ABSTRACT 
            We study firms’ decisions to provide non-GAAP income statements and the information environment consequences of Securities and Exchange Commission (SEC) comment letters directing them to stop disclosing such statements. We find firms voluntarily disclose non-GAAP income statements when firm and disclosure complexity, analyst following, and institutional ownership are higher. Using a difference-in-differences design, we find that, after firms stop disclosing full non-GAAP income statements at the direction of the SEC, the informativeness of non-GAAP earnings and overall earnings announcements decreases, information asymmetry increases, and analyst forecasts become less accurate and more disperse. We also find that firms not receiving a comment letter are more likely to stop providing non-GAAP income statements after an industry peer receives a non-GAAP income statement comment letter. Overall, our evidence suggests SEC comment letters about non-GAAP income statements appear to worsen the information environment for firms previously providing those statements. 
            Data Availability: Data are available from the public sources cited in the text.},
	number = {2},
	urldate = {2023-10-03},
	journal = {The Accounting Review},
	author = {Gomez, Enrique A. and Heflin, Frank L. and Wang, Jasmine},
	month = mar,
	year = {2023},
	pages = {149--175},
}

@misc{B2023,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Auditor {Monitoring} {Incentives} and {Non}-{GAAP} {Earnings}},
	url = {https://papers.ssrn.com/abstract=4079078},
	doi = {10.2139/ssrn.4079078},
	abstract = {This study investigates the role of auditor incentives in determining how auditors influence their clients’ unaudited non-GAAP earnings. I find that, despite the lack of a regulatory requirement, auditors do appear to play a monitoring role with respect to non-GAAP earnings in settings with higher potential risk. Specifically, I find evidence of higher non-GAAP earnings quality when auditors face greater reputation risk, regulatory risk, or client litigation risk. However, I also find evidence of a reduction in auditor monitoring when auditor independence may be impaired by economic bonding. I also document that auditor incentives are associated with the aggressiveness of non-GAAP earnings disclosures. My findings inform ongoing regulatory considerations regarding whether non-GAAP disclosures should be subject to greater auditor oversight, as well as the emerging literature that examines whether auditors play a role in their clients’ unaudited non-GAAP earnings.},
	language = {en},
	urldate = {2023-10-03},
	author = {Bakke, Ashleigh},
	month = aug,
	year = {2023},
	keywords = {Non-GAAP earnings, PCAOB standards, audit quality, audit risk},
}

