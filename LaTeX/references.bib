@article{dunn_impact_2021,
	title = {The {Impact} of {Mandatory} {Auditor} {Tenure} {Disclosures} on {Ratification} {Voting}, {Auditor} {Dismissal}, and {Audit} {Pricing}*},
	volume = {38},
	issn = {0823-9150, 1911-3846},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/1911-3846.12708},
	doi = {10.1111/1911-3846.12708},
	abstract = {ABSTRACT 
            Recent amendments to Auditing Standard (AS) 3101 require disclosure of the initial year of the auditor‐client relationship in the audit report. As the standard was being discussed, auditors, clients, and some PCAOB members expressed reservations about the necessity of tenure disclosures and were particularly concerned about disclosing tenure in the audit report. Our purpose is to investigate whether the tenure disclosures mandated by AS 3101 are associated with changes in stakeholder behavior. We predict and find that after the implementation date, ratification votes against the auditor and the probability of subsequent auditor dismissal increase for long‐tenured versus short‐tenured auditors. Results from a path analysis further suggest that the relative increase in dismissal for long‐tenured auditors appears to be influenced directly through tenure disclosures and indirectly through ratification voting. We also predict and find that negotiating power decreases for long‐tenured auditors as evidenced by lower audit fees. Our results are comparable for companies that voluntarily disclosed and companies that did not disclose auditor tenure in their proxy statements prior to the AS 3101 amendment. Overall, our study suggests that mandatory disclosure of auditor tenure in the audit report significantly affects stakeholder behavior. The PCAOB should consider our findings carefully as they evaluate whether AS 3101 is achieving its intended purpose. 
          ,  
            RÉSUMÉ 
             
              Impact de la divulgation obligatoire de la durée des mandats des auditeurs sur le scrutin de ratification, la destitution des auditeurs et le prix des audits 
             
            À la suite de récentes modifications à la norme d'audit (NA) 3101, il est maintenant obligatoire d'indiquer dans le rapport d'audit en quelle année a commencé la relation auditeur‐client. Lors des discussions relatives à la norme, certains auditeurs, clients, et membres du PCAOB ont exprimé des réserves sur la nécessité de mentionner la durée des mandats des auditeurs et étaient particulièrement préoccupés par l'inclusion de ce renseignement dans le rapport d'audit. Notre objectif est de vérifier si la communication de la durée des mandats prescrite par la NA 3101 est associée à des changements de comportement chez les parties prenantes. Nous prédisons et montrons qu'après la date d'entrée en vigueur de la norme, les votes de ratification contre l'auditeur et la probabilité de destitution subséquente s'accroissent de façon plus importante chez les auditeurs en poste depuis longtemps que chez ceux en fonction depuis peu. Les résultats d'une analyse causale révèlent aussi que l'augmentation relative des destitutions d'auditeurs de longue date semble être directement influencée par la divulgation de la durée des mandats et indirectement par le scrutin de ratification. En outre, nous prédisons et établissons que les auditeurs en poste depuis longtemps perdent une partie de leur pouvoir de négociation, comme en témoignent les honoraires d'audit plus faibles. Nos résultats sont similaires pour les entreprises qui indiquaient volontairement la durée du mandat de leur auditeur et celles qui ne fournissaient pas ce renseignement dans leurs circulaires de procuration avant l'entrée en vigueur des modifications à la NA 3101. Dans l'ensemble, notre étude donne à penser que la communication obligatoire de la durée des mandats des auditeurs dans le rapport d'audit influence considérablement le comportement des parties prenantes. Le PCAOB devrait examiner nos résultats avec attention au moment d'évaluer si la NA 3101 atteint son objectif.},
	language = {en},
	number = {4},
	urldate = {2023-08-27},
	journal = {Contemporary Accounting Research},
	author = {Dunn, Ryan T. and Lundstrom, Nathan G. and Wilkins, Michael S.},
	month = dec,
	year = {2021},
	pages = {2871--2917},
}

