	title = {Audit {Prices}, {Product} {Differentiation}, and {Scale} {Economies}: {Further} {Evidence} from the {Australian} {Market}},
	volume = {24},
	number = {2},
	journal = {Journal of Accounting Research},
	author = {Francis, Jere R and Stokes, Donald J},
