@article{G2023,
	title = {What's in a {Name}? {Investors}' {Reactions} to {Non}‐{GAAP} {Labels}},
	volume = {40},
	issn = {0823-9150, 1911-3846},
	shorttitle = {What's in a {Name}?},
	doi = {10.1111/1911-3846.12829},
	abstract = {ABSTRACT 
            Using a mixed‐methods approach, I investigate how the terms that firms use to label non‐GAAP earnings interact with investors' scrutiny of non‐GAAP reporting to affect investors' information search behavior and investment decisions. This study informs regulators, who have expressed concern over the mislabeling of non‐GAAP measures, and managers, who are often criticized for their misuse of discretion in non‐GAAP reporting. I first provide descriptive evidence on the non‐GAAP labels used in practice, followed by a survey to understand what investors believe these labels convey about earnings quality. Finally, drawing on theory from psychology, I predict and then find in an experiment that investors who are more likely to scrutinize non‐GAAP reporting are not affected by non‐GAAP labels when deciding to seek out the non‐GAAP reconciliation, and react positively to appropriately used labels. However, investors who are less likely to scrutinize non‐GAAP reporting rely on the cue provided by the label when deciding whether to seek out the non‐GAAP reconciliation, and are more likely to be misled by inappropriately used labels. For regulators, these findings validate concerns related to the mislabeling of non‐GAAP measures and suggest increased non‐GAAP scrutiny helps counteract mislabeling. For managers, these findings suggest investors react favorably to the appropriate use of discretion in non‐GAAP reporting. 
          ,  
            RÉSUMÉ 
             
              Qu'y a‐t‐il dans un nom? Réactions des investisseurs aux labels de qualité non conformes aux PCGR 
             
            À l'aide d'une approche de méthodes mixtes, l'auteure examine comment les critères utilisés par les entreprises pour déterminer les mesures de résultat non conformes aux PCGR interagissent avec la surveillance des informations non conformes aux PCGR exercée par les investisseurs pour influencer leur comportement en matière de recherche d'informations et de décisions d'investissement. Cette étude permet d'informer les autorités de règlementation, qui ont exprimé leur inquiétude quant aux erreurs d'évaluation des mesures non conformes aux PCGR, et les gestionnaires, qui sont souvent critiqués pour leur utilisation abusive de leur pouvoir discrétionnaire dans la présentation d'information non conforme aux PCGR. L'auteure fournit d'abord des données descriptives sur les labels de qualité non conformes aux PCGR utilisés dans la pratique, puis réalise une enquête pour comprendre ce que ces labels révèlent sur la qualité des résultats selon les investisseurs. Enfin, en s'appuyant sur les théories de la psychologie, elle prédit puis constate en réalisant une expérience que les investisseurs plus susceptibles de surveiller les informations non conformes aux PCGR ne sont pas affectés par les labels de qualité non conformes aux PCGR lorsqu'ils décident de faire le rapprochement non conforme aux PCGR, et réagissent positivement aux labels utilisés de manière appropriée. Cependant, les investisseurs moins susceptibles de surveiller les informations non conformes aux PCGR se fient à l'indice fourni par le label de qualité lorsqu'ils décident de faire le rapprochement non conforme aux PCGR et sont plus susceptibles d'être induits en erreur par des labels utilisés de manière inappropriée. Pour les autorités de règlementation, ces conclusions confirment les préoccupations liées aux erreurs d'évaluation des mesures non conformes aux PCGR et suggèrent qu'une surveillance accrue de celles‐ci aide à contrer les erreurs d'évaluation. Pour les gestionnaires, ces conclusions indiquent que les investisseurs réagissent favorablement à l'utilisation appropriée de la discrétion en matière d'information non conforme aux PCGR.},
	language = {en},
	number = {2},
	journal = {Contemporary Accounting Research},
	author = {Garavaglia, Shannon},
	month = may,
	year = {2023},
	pages = {897--924},
}

