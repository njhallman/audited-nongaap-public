@article{LMZ2011,
	title = {Can big 4 versus non-big 4 differences in audit-quality proxies be attributed to client characteristics?},
	volume = {86},
	issn = {00014826},
	doi = {10.2308/accr.00000009},
	abstract = {This study examines whether differences in proxies for audit quality between Big 4 and non-Big 4 audit firms could be a reflection of their respective clients' characteristics. In our analyses, we use three audit-quality proxies - Discretionary accruals, the ex ante cost-of-equity capital, and analyst forecast accuracy - And employ propensity-score and attribute-based matching models in attempt to control for differences in client characteristics between the two auditor groups while estimating the audit-quality effects. Using these matching models, we find that the effects of Big 4 auditors are insignificantly different from those of non-Big 4 auditors with respect to the three audit-quality proxies. Our results suggest that differences in these proxies be-tween Big 4 and non-Big 4 auditors largely reflect client characteristics and, more specifically, client size. We caution the reader that this study has not resolved the question, although we hope that it encourages other researchers to explore alternative methodologies that separate client characteristics from audit-quality effects.},
	number = {1},
	journal = {Accounting Review},
	author = {Lawrence, Alastair and Minutti-Meza, Miguel and Zhang, Ping},
	month = jan,
	year = {2011},
	keywords = {Analyst forecast accuracy, Attribute-based matching, Big 4 versus non-Big 4 audit quality, Discretionary accruals, Ex ante cost-of-equity capital, Propensity-score matching},
	pages = {259--286},
}

@article{HKS2022b,
	title = {Are audit fees discounted by successor auditors?},
	abstract = {Due to an audit fee disclosure issue in years when companies change auditors, Barua, Lennox, and Raghunandan (2020) (hereafter, BLR) dispute prior findings that successor auditors discount audit fees to attract new clients. In this study, we reexamine whether audit fee discounting occurs and, to the extent that it does occur, whether it impairs audit quality. We use the same dataset as BLR but sidestep the BLR fee disclosure issue by examining fees in the years surrounding auditor changes. Our conclusions differ from BLR; specifically, we find that successor auditors discount audit fees for new clients, these discounts persist for several years, and the fee discounts sometimes impair audit quality. We find that fee discounting occurs regardless of whether the predecessor auditor charged abnormally high or low fees before being replaced, suggesting that the fee reduction after an auditor change is not simply the elimination of economic rents. We also find that fee discounting is most likely when clients change from Big 4 to non-Big 4 auditors, although discounting also occurs for within-type (i.e., within Big 4 and non-Big 4) auditor changes. Finally, consistent with a "winner's curse" effect, we find that large fee discounts are associated with lower-quality initial-year audit engagements. However, quality quickly improves as newly appointed auditors become more familiar with their clients.},
	journal = {Working Paper},
	author = {Hallman, Nicholas J and Kim, Minjae and Schmidt, Jaime J},
	year = {2022},
	keywords = {audit fee discounting, audit quality, low-balling},
}

@inproceedings{KMS2016,
	title = {Non-big 4 local market leadership and its effect on competition},
	volume = {91},
	doi = {10.2308/accr-51198},
	abstract = {This study examines local characteristics associated with non-Big 4 local market leadership and the impact of non-Big 4 local market leadership on competition. We identify non-Big 4 local market leaders by collecting accounting firm rankings from business publications for 46 of the largest metropolitan statistical areas from 2005-2010. These rankings are based on the number of local office employees and provide a more holistic measure of office size than measures based on public company audit fees. We find local supply and demand factors are significantly associated with non-Big 4 local market leadership and that non-Big 4 leadership is associated with lower overall audit fees in the local market. We also find that non-Big 4 leaders earn a fee premium over other non-Big 4 auditors. Our results imply that non-Big 4 leaders increase local market competition.},
	booktitle = {Accounting {Review}},
	publisher = {American Accounting Association},
	author = {Keune, Marsha B. and Mayhew, Brian W. and Schmidt, Jaime J.},
	month = may,
	year = {2016},
	note = {Issue: 3
ISSN: 00014826},
	keywords = {Audit fee premium, Big 4 market competition, Local audit market},
	pages = {907--931},
}

@article{F1984,
	title = {The effect of audit firm size on audit prices. {A} study of the {Australian} {Market}},
	volume = {6},
	abstract = {The effect of audit firm size on audit prices is a complex function of competition in the market for audit services, product differentiation, and scale economies to large firms. In this study, a competitive market is supported in Australia with product differentiation to Big Eight accounting firms. Specifically, Big Eight accounting firms have significantly higher audit prices than non-Big Eight firms. This result holds for both 'large' and 'small' auditees. A test is also made of price cutting in the Australian market. Price cutting is defined as lower initial audit fees than continuing engagement fees for a comparable audit. Test results do not evidence price-cutting behavior by accounting firms. There is in fact weak evidence that initial audit fees are higher than continuing engagement fee levels. Higher initial fees suggest that accounting firms may recover at least some of the audit start-up costs immediately.},
	journal = {Journal of Accounting and Economics},
	author = {Francis, Jere R},
	year = {1984},
	pages = {133--155},
}

@article{CHM2022,
	title = {Managers' opportunistic use of alternative labels for non-{GAAP} earnings},
	abstract = {For decades managers have been presenting their non-GAAP earnings using alternative labels, such as "adjusted EPS", "operating earnings", or even "core earnings," instead of using the standard "non-GAAP" label. Fifty nine percent of the firms reporting non-GAAP earnings in 2015 use these alternative labels, only forty-one percent of firms use the standard "non-GAAP" label. We investigate whether managers use these alternative labels to mislead or to inform investors. We find that, relative to firms using the standard non-GAAP label, firms using alternative labels have larger non-GAAP exclusions, and these exclusions are also of a lower quality than the exclusions under the standard "non-GAAP" label, as they include more persistent items and deviate more from analysts' exclusions. Managers using alternative labels are only able to avoid reporting losses and improve upon prior period, but are not able to meet analysts' consensus forecasts. Managers using alternative labels tend to display non-GAAP earnings more prominently in earnings press releases, especially when the exclusions are large. Finally, our investigation of the market reaction to non-GAAP exclusions largely suggests that investors do not discern the lower-quality non-GAAP exclusions under alternative labels. Our results should be of interest to regulators and standard setters, as well as to investors and researchers alike. PRELIMINARY … PLEASE DO NOT SHARE / POST ONLINE JEL Code: Key words: non-GAAP earnings, alternative non-GAAP labels, exclusions, managerial opportunism, mislead, investors 2 Managers' Opportunistic Use of Alternative Labels for Non-GAAP Earnings "Too many managements-and the number seems to grow every year-are looking for any means to report, and indeed feature, 'adjusted earnings' that are higher than their company's GAAP earnings."-Warren Buffet, Letter to the Shareholders, 2016. "… in too many cases, the non-GAAP information, which is meant to supplement the GAAP information, has become the key message to investors, crowding out and effectively supplanting the GAAP presentation."-Mary Jo White, SEC chairwoman, 2016.},
	journal = {Working Paper},
	author = {Chen, Shuping and Hallman, Nicholas and Miao, Bin},
	year = {2020},
}

